# The live bundle and operational state must be outside this source repository.
KB_BUNDLE_PATH=/data/bundle
KB_STATE_PATH=/data/state
# Required host-side deployment taxonomy mounted by Compose.
KB_TAXONOMY_FILE=
# The image contains no implicit taxonomy. Compose mounts the selected file at
# this container path.
KB_TAXONOMY_PATH=/app/config/taxonomy.yaml
KB_SCOPE=default

# Use "disabled" only while binding to loopback for local development.
KB_AUTH_MODE=jwt
KB_JWT_JWKS_URI=https://identity.example.com/.well-known/jwks.json
KB_JWT_ISSUER=https://identity.example.com/
KB_JWT_AUDIENCE=knowledge-gateway

KB_HOST=0.0.0.0
KB_PORT=8000
KB_MCP_PATH=/mcp
KB_LOG_LEVEL=INFO
KB_LOCAL_ACTOR=local-development

# Required policy switch. When true, every accepted mutation tries a
# best-effort `git push`.
# A failed push never rolls back the canonical local write.
KB_PUSH_AFTER_WRITE=false
KB_GIT_REMOTE=origin

# Optional JSON status written by the independent snapshot job.
KB_SNAPSHOT_STATUS_PATH=/data/state/snapshot-status.json
