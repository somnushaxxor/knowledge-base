# The live bundle and operational state must be outside this source repository.
KB_BUNDLE_PATH=/data/bundle
KB_STATE_PATH=/data/state
# Required host-side deployment taxonomy mounted by Compose.
KB_TAXONOMY_FILE=
# The image contains no implicit taxonomy. Compose mounts the selected file at
# this container path.
KB_TAXONOMY_PATH=/app/config/taxonomy.yaml
KB_SCOPE=default

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the real value outside source control.
KB_AUTH_MODE=token
KB_ACCESS_TOKEN=

KB_HOST=0.0.0.0
KB_PORT=8000
KB_MCP_PATH=/mcp
KB_LOG_LEVEL=INFO
# Used only with KB_AUTH_MODE=disabled on a loopback bind.
KB_LOCAL_ACTOR=local-development

# Periodic Git backup interval in hours. Live writes stay uncommitted until the
# scheduler wakes, creates one `backup <timestamp>` commit, and best-effort
# pushes to the private remote. Use 6 for a six-hour cadence; 0 disables the
# scheduler (manual/test only). Fractions are allowed (e.g. 0.5 = 30 minutes).
KB_BACKUP_INTERVAL_HOURS=6
KB_GIT_REMOTE=origin
